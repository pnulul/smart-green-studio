# Local server only. Leave credentials blank for public demonstration.
HOST=127.0.0.1
PORT=3000
SGS_ALLOW_DEMO=true

# Optional private course server. Never commit .env.
SGS_ALLOWED_STUDENT_IDS=
SGS_COURSE_PASSCODE=
SGS_SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SGS_ALLOWED_ORIGINS=

# Public build options. Never put a secret in VITE_* variables.
# SGS_BASE_PATH=/smart-green-studio/
# VITE_DATA_BASE_URL=https://your-data-host.example/data
# VITE_API_BASE_URL=

# Public CARTO Basemaps browser key, restricted to this website's host.
# Set the GitHub Actions variable SGS_CARTO_BASEMAP_KEY for the Pages build.
# VITE_CARTO_BASEMAP_KEY=

# Public news search endpoint; set SGS_NEWS_SEARCH_URL in GitHub Actions.
# VITE_NEWS_SEARCH_URL=https://your-news-service.example/api/news/search
